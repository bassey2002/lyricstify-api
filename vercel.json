{ 
  "regions": ["sin1"], 
  "functions": { 
    "api/serverless.ts": { 
      "runtime": "nodejs@22.x" 
    } 
  }, 
  "build": { 
    "env": { 
      "NODEJS_AWS_HANDLER_NAME": "handler" 
    } 
  }, 
  "rewrites": [ 
    { 
      "source": "/(.*)", 
      "destination": "/api/serverless" 
    } 
  ] 
}